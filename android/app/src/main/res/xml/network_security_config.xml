<?xml version="1.0" encoding="utf-8"?>
<!-- 系统在店里的 NAS 上，局域网用 http（http://192.168.31.200:8790），所以允许明文 http -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

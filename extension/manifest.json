{
  "manifest_version": 3,
  "name": "3D 运营管理系统 · 浏览器扩展",
  "version": "3.1.0",
  "description": "AI 客服（卖家中心聊天页读消息、生成泰语回复）；面单 PDF 转交；运营采集（竞品、搜索结果、店铺、卖家后台数据页，今日巡逻）；选品（模型网站上的推荐分和采集、用浏览器登录状态下载模型文件、关注巡逻）——都发到你自己的 3D 运营管理系统。",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "3D 运营管理系统 · 插件",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "downloads",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.lazada.co.th/*",
        "https://*.lazada.com/*",
        "https://*.lazada.com.my/*",
        "https://*.lazada.sg/*",
        "https://*.shopee.co.th/*",
        "https://*.shopee.com/*",
        "https://*.shopee.com.my/*",
        "https://*.tiktok.com/*",
        "https://*.tiktokshop.com/*",
        "https://*.tiktokglobalshop.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.lazada.co.th/*",
        "https://*.lazada.com/*",
        "https://*.lazada.com.my/*",
        "https://*.lazada.sg/*",
        "https://*.shopee.co.th/*",
        "https://*.shopee.com/*",
        "https://*.shopee.com.my/*",
        "https://*.tiktok.com/*",
        "https://*.tiktokshop.com/*",
        "https://*.tiktokglobalshop.com/*",
        "https://*.bigseller.com/*",
        "https://bigseller.com/*"
      ],
      "js": [
        "pdfgrab.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.lazada.co.th/*",
        "https://shopee.co.th/*",
        "https://*.shopee.co.th/*",
        "https://*.tiktok.com/*",
        "https://*.tiktokshop.com/*",
        "https://*.tiktokglobalshop.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://makerworld.com/*",
        "https://*.makerworld.com/*",
        "https://makerworld.com.cn/*",
        "https://*.makerworld.com.cn/*",
        "https://printables.com/*",
        "https://*.printables.com/*",
        "https://thingiverse.com/*",
        "https://*.thingiverse.com/*"
      ],
      "js": [
        "cur_sites_builtin.js",
        "cur_sites.js",
        "cur_extract.js",
        "cur_picker.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
